#!/bin/bash
set -euo pipefail

curl -sfL https://get.k3s.io -o /tmp/install-k3s.sh
INSTALL_K3S_VERSION='${k3s_version}' sh /tmp/install-k3s.sh --disable traefik --disable servicelb
rm /tmp/install-k3s.sh

cat > /usr/local/sbin/refresh-k3s-ecr-secret <<'SCRIPT'
#!/bin/bash
set -euo pipefail
password=$(aws ecr get-login-password --region '${aws_region}')
/usr/local/bin/k3s kubectl -n default create secret docker-registry ecr-pull \
  --docker-server='${registry}' --docker-username=AWS --docker-password="$password" \
  --dry-run=client -o yaml | /usr/local/bin/k3s kubectl apply -f -
SCRIPT
chmod 700 /usr/local/sbin/refresh-k3s-ecr-secret

cat > /etc/systemd/system/k3s-ecr-refresh.service <<'UNIT'
[Unit]
Description=Refresh k3s ECR pull credentials
After=k3s.service
Requires=k3s.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/refresh-k3s-ecr-secret
UNIT

cat > /etc/systemd/system/k3s-ecr-refresh.timer <<'UNIT'
[Unit]
Description=Refresh ECR credentials before they expire

[Timer]
OnBootSec=2min
OnUnitActiveSec=6h
Persistent=true

[Install]
WantedBy=timers.target
UNIT

systemctl daemon-reload
systemctl enable --now k3s-ecr-refresh.timer

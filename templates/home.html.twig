{% extends 'base.html.twig' %}

{% block title %}Bookhive · Dashboard{% endblock %}

{% block body %}
    <h1>📚 Bookhive</h1>
    <p class="subtitle">Manage your bookshop catalog</p>

    <div class="card-grid" style="margin-top: 32px;">
        <a href="{{ path('book_list') }}" class="card" style="text-decoration:none; color:inherit;">
            <h3>📖 Books</h3>
            <p>{{ bookCount }} book{{ bookCount != 1 ? 's' : '' }} in catalog</p>
            <div class="card-actions" style="border-top:none; padding-top:0;">
                <span class="btn btn-primary">View Books</span>
            </div>
        </a>

        <a href="{{ path('author_list') }}" class="card" style="text-decoration:none; color:inherit;">
            <h3>✍️ Authors</h3>
            <p>{{ authorCount }} author{{ authorCount != 1 ? 's' : '' }} registered</p>
            <div class="card-actions" style="border-top:none; padding-top:0;">
                <span class="btn btn-primary">View Authors</span>
            </div>
        </a>

        <a href="{{ path('category_list') }}" class="card" style="text-decoration:none; color:inherit;">
            <h3>🏷️ Categories</h3>
            <p>{{ categoryCount }} categor{{ categoryCount != 1 ? 'ies' : 'y' }} defined</p>
            <div class="card-actions" style="border-top:none; padding-top:0;">
                <span class="btn btn-primary">View Categories</span>
            </div>
        </a>

        <a href="{{ path('publisher_list') }}" class="card" style="text-decoration:none; color:inherit;">
            <h3>🏢 Publishers</h3>
            <p>{{ publisherCount }} publisher{{ publisherCount != 1 ? 's' : '' }} on file</p>
            <div class="card-actions" style="border-top:none; padding-top:0;">
                <span class="btn btn-primary">View Publishers</span>
            </div>
        </a>
    </div>

    <div style="margin-top: 40px; padding-top: 24px; border-top: 1px solid var(--border);">
        <h3 style="margin-bottom: 12px; font-size: 1rem; color: var(--muted);">Quick Add</h3>
        <div style="display: flex; gap: 10px; flex-wrap: wrap;">
            <a href="{{ path('book_new') }}" class="btn btn-outline">+ Book</a>
            <a href="{{ path('author_new') }}" class="btn btn-outline">+ Author</a>
            <a href="{{ path('category_new') }}" class="btn btn-outline">+ Category</a>
            <a href="{{ path('publisher_new') }}" class="btn btn-outline">+ Publisher</a>
        </div>
    </div>
{% endblock %}

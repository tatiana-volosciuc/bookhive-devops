{% extends 'base.html.twig' %}

{% block title %}Add Author · Bookhive{% endblock %}

{% block body %}
    <h1>Add a New Author</h1>
    <p class="subtitle"><a href="{{ path('author_list') }}">&larr; Back to Authors</a></p>

    <form method="post">
        <label for="name">Name *</label>
        <input type="text" id="name" name="name" required value="{{ name|default('') }}">

        <label for="bio">Bio</label>
        <textarea id="bio" name="bio" rows="4">{{ bio|default('') }}</textarea>

        <div style="margin-top: 24px;">
            <button type="submit" class="btn btn-primary">Create Author</button>
        </div>
    </form>
{% endblock %}
